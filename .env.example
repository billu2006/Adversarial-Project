# Compose sets all of these itself, so you do not need this file to run the
# project. Copy it to .env only if you want to run uvicorn or the worker
# directly on your host.

ENVIRONMENT=local
LOG_LEVEL=INFO
JSON_LOGS=true

DATABASE_URL=postgresql+psycopg://benchmark:benchmark@localhost:5432/benchmark
REDIS_URL=redis://localhost:6379/0

# Shared secret for every /v1 route. Fine as-is on localhost; change it the
# moment the service is reachable by anything else.
API_KEY=local-development-key

# "redis" is the real path. "inline" runs benchmarks in the API process, which
# is only useful for a single-container demo.
QUEUE_BACKEND=redis

# Resource limits. See "Security considerations" in the README.
JOB_TIMEOUT_SECONDS=900
MAX_ATTACKS_PER_JOB=5
MAX_ACTIVE_JOBS=50
BENCHMARK_MAX_SAMPLES=2048
